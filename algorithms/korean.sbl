/* === 격 조사 제거 === */
define remove_nominal_suffixes as (
  backwards (
    [substring] among (
      '{s_C5D0}{s_C11C}' ( delete )
      '{s_BD80}{s_D130}' ( delete )
      '{s_AE4C}{s_C9C0}' ( delete )
      '{s_C5D0}{s_AC8C}' ( delete )
      '{s_D55C}{s_D14C}' ( delete )
      '{s_C640}' ( delete )
      '{s_ACFC}' ( delete )
      '{s_B098}' ( delete )
      '{s_AC00}' ( delete )
      '{s_C744}' ( delete )
      '{s_B97C}' ( delete )
      '{s_C758}' ( delete )
      '{s_C5D0}' ( delete )
      '{s_B85C}' ( delete )
      '{s_B3C4}' ( delete )
      '{s_B9CC}' ( delete )
      '{s_D558}{s_ACE0}' ( delete )
      '{s_CC98}{s_B7FC}' ( delete )
      '{s_B300}{s_B85C}' ( delete )
      '{s_B77C}{s_B3C4}' ( delete )
      '{s_C870}{s_CC28}' ( delete )
      '{s_B9C8}{s_C800}' ( delete )
      '{s_C5D0}{s_C11C}{s_C11C}' ( delete )
      '{s_C73C}{s_B85C}{s_BD80}{s_D130}' ( delete )
    )
  )
)

define remove_verbal_suffixes as (
  backwards (
    [substring] among (
      '{s_C2B5}{s_B2C8}{s_B2E4}' ( delete )
      '{s_C5B4}{s_C694}' ( delete )
      '{s_C544}{s_C694}' ( delete )
      '{s_B9CC}' ( delete )
      '{s_ACE0}' ( delete )
      '{s_B2E4}' ( delete )
      '{s_C790}' ( delete )
      '{s_B77C}' ( delete )
      '{s_AC8C}' ( delete )
      '{s_C5C8}{s_C5B4}{s_C694}' ( delete )
      '{s_C558}{s_C5B4}{s_C694}' ( delete )
      '{s_ACA0}{s_C5B4}{s_C694}' ( delete )
      '{s_C138}{s_C694}' ( delete )
      '{s_C5C8}' ( delete )  // 었
      '{s_C558}' ( delete )  // 았
      '{s_C600}' ( delete )  // 였
      '{s_C73C}' ( delete )
      '{s_B108}' ( delete )
      '{s_C9C0}' ( delete )
      '{s_B2C8}' ( delete )
      '{s_AE30}' ( delete )
    )
  )
)


/* === 불규칙 용언 처리 === */
define handle_irregular_verbs as (
  /* ㅂ 불규칙: ㅂ이 ㄴ, ㅅ을 만나 ㅍ으로 */
  if testat(1) and find_among_b(KoreanStemmer.a_irregular_bp) != 0 then
    replace_at(-1, 1, '{H}')  // ㅂ -> ㅍ
  fi
  /* ㄷ 불규칙: ㄷ이 ㅏ, ㅓ를 만나 ㄹ로 */
  if testat(1) and find_among_b(KoreanStemmer.a_irregular_dt) != 0 then
    replace_at(-1, 1, '{R}')  // ㄷ -> ㄹ
  fi
  /* ㅎ 불규칙: ㅎ이 ㅏ, ㅓ를 만나 ㄹ로 */
  if testat(1) and find_among_b(KoreanStemmer.a_irregular_h) != 0 then
    replace_at(-1, 1, '{R}')  // ㅎ -> ㄹ
  fi
  /* ㅅ 불규칙: ㅅ이 ㅏ, ㅓ를 만나 ㅆ으로 */
  if testat(1) and find_among_b(KoreanStemmer.a_irregular_s) != 0 then
    replace_at(-1, 1, '{SS}')  // ㅅ -> ㅆ
  fi
  /* ㄴ 불규칙: ㄴ이 ㅏ, ㅓ를 만나 ㄴ 유지 (변경 없음) */
  /* ㄹ 불규칙: ㄹ이 ㅏ, ㅓ를 만나 ㄹ 유지 (변경 없음) */
)

/* === 불규칙 용언 among 테이블 === */
define KoreanStemmer.a_irregular_bp as (
  among (
    '{B}' ( 1 )  // ㅂ 종성
  )
)

define KoreanStemmer.a_irregular_dt as (
  among (
    '{C}' ( 1 )  // ㄷ 종성
  )
)

define KoreanStemmer.a_irregular_h as (
  among (
    '{H}' ( 1 )  // ㅎ 종성
  )
)

define KoreanStemmer.a_irregular_s as (
  among (
    '{S}' ( 1 )  // ㅅ 종성
  )
)

define stem as (
  do remove_nominal_suffixes
  do remove_verbal_suffixes
)