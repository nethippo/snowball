/* Korean Stemmer for Snowball - v2: basic suffix stripping */
externals ( stem )

routines (
  remove_nominal_suffixes
  remove_verbal_suffixes
)

stringescapes { }

/* === Hangul 초성 (19자) === */
stringdef G '{U+1100}'
stringdef KK '{U+1101}'
stringdef N '{U+1102}'
stringdef D '{U+1103}'
stringdef TT '{U+1104}'
stringdef R '{U+1105}'
stringdef M '{U+1106}'
stringdef B '{U+1107}'
stringdef PP '{U+1108}'
stringdef S '{U+1109}'
stringdef SS '{U+110A}'
stringdef ENG '{U+110B}'
stringdef J '{U+110C}'
stringdef JJ '{U+110D}'
stringdef C '{U+110E}'
stringdef K '{U+110F}'
stringdef T '{U+1110}'
stringdef P '{U+1111}'
stringdef H '{U+1112}'

/* === Hangul 중성 (21자) === */
stringdef A '{U+1161}'
stringdef AE '{U+1162}'
stringdef YA '{U+1163}'
stringdef YAE '{U+1164}'
stringdef E '{U+1165}'
stringdef E2 '{U+1166}'
stringdef YEO '{U+1167}'
stringdef YE '{U+1168}'
stringdef O '{U+1169}'
stringdef WA '{U+116A}'
stringdef WAE '{U+116B}'
stringdef OE '{U+116C}'
stringdef YO '{U+116D}'
stringdef U '{U+116E}'
stringdef WE '{U+116F}'
stringdef WE2 '{U+1170}'
stringdef WI '{U+1171}'
stringdef UI '{U+1172}'
stringdef YU '{U+1173}'
stringdef EU '{U+1174}'
stringdef I '{U+1175}'

/* === 모음/자음 그룹 === */
groupings ( backVowels frontVowels allVowels consonants )
define backVowels '{A}{E}{O}{U}{EU}'
define frontVowels '{AE}{E2}{OE}{WI}{UI}'
define allVowels '{A}{AE}{YA}{YAE}{E}{E2}{YEO}{YE}{O}{WA}{WAE}{OE}{YO}{U}{WE}{WE2}{WI}{UI}{YU}{EU}{I}'
define consonants '{G}{KK}{N}{D}{TT}{R}{M}{B}{PP}{S}{SS}{ENG}{J}{JJ}{C}{K}{T}{P}{H}'

